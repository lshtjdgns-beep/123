# .env.local 로 복사해서 사용하세요.
#
# ⚠ ANTHROPIC_API_KEY 는 절대 채우지 마세요.
#   값이 있으면 Claude CLI가 구독 로그인(npx @anthropic-ai/claude-code login) 대신
#   그 키로 인증을 시도합니다. 키가 무효하면 매 호출마다 ~3분씩 재시도 후 실패합니다.
#   (claudeClient.ts 가 구독 로그인이 있으면 서브프로세스 환경에서 키를 제거하지만,
#    애초에 비워두는 것이 기본입니다.)
# ANTHROPIC_API_KEY=

GEMINI_API_KEY=
OPENAI_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=
NAVER_BLOG_ID=
